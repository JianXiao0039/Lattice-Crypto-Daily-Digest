# Keep source and documentation line endings stable across Windows and CI.
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Keep double-clickable Windows scripts in CRLF form.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Preserve the original incident JSON byte hash (including CRLF).
tests/fixtures/v43_oct17/2026-10-17.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
